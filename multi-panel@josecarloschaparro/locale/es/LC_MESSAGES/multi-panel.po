msgid "Application Menu"
msgstr "Menú de aplicaciones"

msgid "Activities"
msgstr "Actividades"

msgid "Accessbility"
msgstr "Accesibilidad"

msgid "Keyboard"
msgstr "Teclado"

msgid "Screen Sharing"
msgstr "Compartir pantalla"

msgid "Screen Recording"
msgstr "Grabación de pantalla"

msgid "Quick Settings"
msgstr "Ajustes rápidos"

msgid "Date and Clock"
msgstr "Fecha y reloj"

msgid "Settings"
msgstr "Configuración"

msgid "Show bar on additional monitors"
msgstr "Mostrar la barra en monitores adicionales"

msgid "General"
msgstr "General"

msgid "General behavior for additional monitors and desktop integration."
msgstr "Comportamiento general de los monitores adicionales y la integración con el escritorio."

msgid "Enable hot corners"
msgstr "Activar esquinas activas"

msgid "Show screenshot tools on all monitors"
msgstr "Mostrar herramientas de captura en todos los monitores"

msgid "Indicators"
msgstr "Indicadores"

msgid "Reorder indicators, choose their group, and show or hide them on additional monitors."
msgstr "Reordena los indicadores, elige su grupo y muéstralos u ocúltalos en los monitores adicionales."

msgid "Transferred Indicators"
msgstr "Indicadores transferidos"

msgid "Move stable indicators away from the primary bar to a specific monitor."
msgstr "Mueve los indicadores estables de la barra principal a un monitor específico."

msgid "Indicators transferred to additional monitors"
msgstr "Indicadores transferidos a monitores adicionales"

msgid "Add indicator"
msgstr "Añadir indicador"

msgid "Remove indicator"
msgstr "Eliminar indicador"

msgid "Left"
msgstr "Izquierda"

msgid "Center"
msgstr "Centro"

msgid "Right"
msgstr "Derecha"

msgid "Choose where this indicator should appear"
msgstr "Elige dónde debe aparecer este indicador"

msgid "Show or hide this indicator on Multi Monitor Bar"
msgstr "Mostrar u ocultar este indicador en Multi Monitor Bar"

msgid "Select indicator"
msgstr "Seleccionar indicador"

msgid "Cancel"
msgstr "Cancelar"

msgid "Add"
msgstr "Añadir"

msgid "Indicators on Top Panel"
msgstr "Indicadores en la barra superior"

msgid "Monitor index:"
msgstr "Índice del monitor:"

msgid "Layout"
msgstr "Diseño"

msgid "Adjust internal left and right padding for each indicator on additional monitor bars."
msgstr "Ajusta el relleno interno izquierdo y derecho de cada indicador en las barras de monitores adicionales."

msgid "Indicator Padding"
msgstr "Relleno del indicador"

msgid "Adjust internal left and right padding for each indicator."
msgstr "Ajusta el relleno interno izquierdo y derecho de cada indicador."

msgid "Quick Settings gap"
msgstr "Espaciado de ajustes rápidos"

msgid "Indicator gap"
msgstr "Espaciado entre indicadores"

msgid "Panel Layout"
msgstr "Diseño del panel"

msgid "Adjust panel left and right padding and height."
msgstr "Ajusta el relleno izquierdo y derecho y la altura del panel."

msgid "Panel left padding"
msgstr "Relleno izquierdo del panel"

msgid "Panel right padding"
msgstr "Relleno derecho del panel"

msgid "Panel height"
msgstr "Altura del panel"

msgid "Apply to main panel"
msgstr "Aplicar al panel principal"

msgid "Use the same panel height, panel padding, and indicator spacing on the primary GNOME top bar."
msgstr "Usar la misma altura del panel, el mismo relleno del panel y el mismo espaciado entre indicadores en la barra superior principal de GNOME."

msgid "Top Bar"
msgstr "Barra superior"

msgid "No Notifications"
msgstr "Sin notificaciones"

msgid "%OB"
msgstr "%OB"

msgid "%OB %Y"
msgstr "%OB %Y"

msgid "Do Not Disturb"
msgstr "No molestar"

msgid "Clear"
msgstr "Borrar"
